# --- TRENDORA environment (copy to .env for local development) -------------
# Never commit real secrets. In Vercel/Supabase use the environment vault.

# NODE_ENV is set by the tooling (next dev → development, next build/start → production)
# Local Postgres (or `supabase start` → postgresql://postgres:postgres@127.0.0.1:54322/postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trendora
APP_URL=http://localhost:3000

# Sandbox adapters (payments, video, sandbox login, clock control). Must be false in production.
SANDBOX_MODE=true

# 32+ char random strings: `openssl rand -hex 32`
AUTH_JWT_SECRET=replace-with-32-plus-random-characters-000000
SIGNING_SECRET=replace-with-32-plus-random-characters-111111
COUPON_SECRET=replace-with-32-plus-random-characters-222222
SANDBOX_WEBHOOK_SECRET=whsec_sandbox_local_only_0000

# Optional: accept Supabase Auth access tokens (project JWT secret)
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_JWT_SECRET=
# SUPABASE_ANON_KEY=

PLATFORM_COMMISSION_BPS=800
CHECKOUT_TTL_SECONDS=900
MEDIA_DIR=.trendora-data/media

# Optional AI agents (otherwise a labelled rule-based sandbox agent is used)
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
AI_MONTHLY_BUDGET_USD=25

# Require MFA (aal2 tokens) for moderator/finance/admin routes
REQUIRE_MFA_FOR_PRIVILEGED=false
